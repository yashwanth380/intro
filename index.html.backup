    <!-- ======================================================================
         VIEW 4: DOUBT SOLVING (Q&A)
         ====================================================================== -->
    <section id="view-doubts" class="view-section">
      <div class="container doubts-container">
        <div class="doubts-action-bar">
          <div>
            <h2 class="view-title">Doubt Solving Hub</h2>
            <p class="view-subtitle">Ask academic questions, help peers, and earn karma points in a judgment-free zone.</p>
          </div>
          <button class="btn btn-primary" onclick="app.openAskDoubtModal()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            <span>Ask a Doubt</span>
          </button>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="toolbar-bar">
          <div class="search-wrapper">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="doubtSearchInput" class="search-input" placeholder="Search questions by keyword, topic or tag..." oninput="app.filterDoubts()">
          </div>

          <div class="filter-pills" id="doubtSubjectPills">
            <button class="filter-pill active" onclick="app.setDoubtSubject('All', this)">All Subjects</button>
            <button class="filter-pill" onclick="app.setDoubtSubject('Computer Science', this)">Computer Science</button>
            <button class="filter-pill" onclick="app.setDoubtSubject('Mathematics', this)">Mathematics</button>
            <button class="filter-pill" onclick="app.setDoubtSubject('Physics', this)">Physics</button>
            <button class="filter-pill" onclick="app.setDoubtSubject('Electronics', this)">Electronics</button>
          </div>
        </div>

        <!-- Questions List -->
        <div id="doubtsListContainer">
          <!-- Injected by JavaScript -->
        </div>

        <div id="noDoubtsFound" class="empty-state" style="display: none;">
          <div class="empty-icon">❓</div>
          <div class="empty-title">No questions found</div>
          <div class="empty-text">Be the first to ask a doubt or try a different subject filter!</div>
          <button class="btn btn-primary btn-sm" style="margin-top: 1rem;" onclick="app.openAskDoubtModal()">Ask a Doubt</button>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         VIEW 5: CAMPUS ACTIVITIES
         ====================================================================== -->
    <section id="view-activities" class="view-section">
      <div class="container activities-container">
        <div class="doubts-action-bar">
          <div>
            <h2 class="view-title">Campus Activities & Meetups</h2>
            <p class="view-subtitle">Discover casual study groups, practice sessions, photo walks, and social hangouts.</p>
          </div>
          <button class="btn btn-primary" onclick="app.openCreateActivityModal()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="12" y1="10" x2="12" y2="16"></line><line x1="9" y1="13" x2="15" y2="13"></line></svg>
            <span>Propose an Activity</span>
          </button>
        </div>

        <!-- Filter Toolbar -->
        <div class="toolbar-bar">
          <div class="search-wrapper">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="activitySearchInput" class="search-input" placeholder="Search activities by title, location or club..." oninput="app.filterActivities()">
          </div>

          <div class="filter-pills" id="activityCategoryPills">
            <button class="filter-pill active" onclick="app.setActivityCategory('All', this)">All Activities</button>
            <button class="filter-pill" onclick="app.setActivityCategory('Creative', this)">Creative</button>
            <button class="filter-pill" onclick="app.setActivityCategory('Academic', this)">Academic</button>
            <button class="filter-pill" onclick="app.setActivityCategory('Tech', this)">Technology</button>
            <button class="filter-pill" onclick="app.setActivityCategory('Social', this)">Social</button>
          </div>
        </div>

        <!-- Activities Grid -->
        <div class="activities-grid" id="activitiesGrid">
          <!-- Injected by JavaScript -->
        </div>

        <div id="noActivitiesFound" class="empty-state" style="display: none;">
          <div class="empty-icon">📅</div>
          <div class="empty-title">No upcoming activities found</div>
          <div class="empty-text">No activities currently match this filter. Why not propose a meetup yourself?</div>
          <button class="btn btn-primary btn-sm" style="margin-top: 1rem;" onclick="app.openCreateActivityModal()">Propose an Activity</button>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         VIEW 6: STUDENT PROFILES
         ====================================================================== -->
    <section id="view-profile" class="view-section">
      <div class="container profile-container">
        <div class="view-header">
          <h2 class="view-title">Student Profile & Campus Peers</h2>
          <p class="view-subtitle">Manage your personal profile, interests, and discover fellow students on campus.</p>
        </div>

        <div class="profile-layout-grid">
          <!-- Left: My Profile Card -->
          <div class="my-profile-col">
            <div class="my-profile-card">
              <div class="profile-avatar-large" id="profileCardAvatar">AR</div>
              <h3 class="profile-user-name" id="profileCardName">Alex Rivera</h3>
              <div class="profile-user-headline" id="profileCardMajor">Computer Science · Sophomore (Year 2)</div>
              <p class="profile-user-bio" id="profileCardBio">
                "Passionate about front-end architecture, nature photography walks, and finding quiet study spots with great coffee. Always happy to pair program or collaborate!"
              </p>

              <div class="profile-info-block">
                <div class="profile-block-label">Your Selected Interests</div>
                <div class="chips-cluster" id="profileCardInterests">
                  <!-- Injected by JavaScript -->
                </div>
              </div>

              <div class="profile-info-block">
                <div class="profile-block-label">Your Joined Communities (<span id="profileJoinedCount">3</span>)</div>
                <div class="chips-cluster" id="profileCardJoinedBadges">
                  <!-- Injected by JavaScript -->
                </div>
              </div>

              <button class="btn btn-outline" style="width: 100%; margin-top: 1rem;" onclick="app.openEditProfileModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                <span>Edit Profile & Interests</span>
              </button>

              <div class="profile-disclaimer-box">
                ℹ️ <strong>Client-Side Demo:</strong> All profile changes are saved in your browser's local demo storage. No credentials or server sync required.
              </div>
            </div>
          </div>

          <!-- Right: Campus Peer Directory -->
          <div class="peer-directory-col">
            <div class="peers-card">
              <div class="dash-card-header">
                <h3 class="dash-card-title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  <span>Discover Campus Peers</span>
                </h3>
                <span class="badge badge-indigo">Sample Profiles</span>
              </div>
              <p style="font-size: 0.9rem; color: var(--slate-500); margin-bottom: 1rem;">
                Connect with students who share your academic curriculum, hobby spaces, or project interests.
              </p>
              <div id="peerDirectoryList">
                <!-- Injected by JavaScript -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ========================================================================
       MODAL 1: ASK A DOUBT
       ======================================================================== -->
  <div class="modal-overlay" id="modalAskDoubt" onclick="if(event.target === this) app.closeModal('modalAskDoubt')">
    <div class="modal-box" role="dialog" aria-labelledby="modalAskDoubtTitle">
      <div class="modal-header">
        <h3 class="modal-title" id="modalAskDoubtTitle">Ask an Academic Doubt</h3>
        <button class="btn-modal-close" aria-label="Close modal" onclick="app.closeModal('modalAskDoubt')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <form id="formAskDoubt" onsubmit="app.handleDoubtSubmit(event)">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="doubtTitleInput">Question Title *</label>
            <input type="text" id="doubtTitleInput" class="form-input" placeholder="e.g., How does Floyd-Warshall handle negative edge weights?" required minlength="10">
            <div class="form-help">Be specific and descriptive so peers can assist you effectively.</div>
            <div class="form-error" id="doubtTitleError">Please provide a descriptive title (at least 10 characters).</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="doubtSubjectSelect">Subject / Department *</label>
            <select id="doubtSubjectSelect" class="form-select" required>
              <option value="Computer Science">Computer Science</option>
              <option value="Mathematics">Mathematics</option>
              <option value="Physics">Physics</option>
              <option value="Electronics">Electronics</option>
              <option value="General Engineering">General Engineering</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="doubtDescInput">Detailed Explanation & What You've Tried *</label>
            <textarea id="doubtDescInput" class="form-textarea" rows="4" placeholder="Mention the context, assignment question, or error message you encountered..." required minlength="20"></textarea>
            <div class="form-error" id="doubtDescError">Please describe your question in detail (at least 20 characters).</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="doubtTagsInput">Tags (comma-separated)</label>
            <input type="text" id="doubtTagsInput" class="form-input" placeholder="e.g. algorithms, graphs, homework-3">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="app.closeModal('modalAskDoubt')">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span>Post Question</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================================================
       MODAL 2: PROPOSE ACTIVITY
       ======================================================================== -->
  <div class="modal-overlay" id="modalCreateActivity" onclick="if(event.target === this) app.closeModal('modalCreateActivity')">
    <div class="modal-box" role="dialog" aria-labelledby="modalCreateActivityTitle">
      <div class="modal-header">
        <h3 class="modal-title" id="modalCreateActivityTitle">Propose a Campus Activity</h3>
        <button class="btn-modal-close" aria-label="Close modal" onclick="app.closeModal('modalCreateActivity')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <form id="formCreateActivity" onsubmit="app.handleActivitySubmit(event)">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="actTitleInput">Activity Title *</label>
            <input type="text" id="actTitleInput" class="form-input" placeholder="e.g., Weekend Badminton Friendly Matches" required minlength="6">
          </div>

          <div class="form-group">
            <label class="form-label" for="actCategorySelect">Category *</label>
            <select id="actCategorySelect" class="form-select" required>
              <option value="Creative">Creative / Arts</option>
              <option value="Academic">Academic / Study Session</option>
              <option value="Tech">Technology / Coding</option>
              <option value="Social">Social / Outdoor Hangout</option>
            </select>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label class="form-label" for="actDateInput">Date / Day *</label>
              <input type="text" id="actDateInput" class="form-input" placeholder="e.g., Saturday, 4:30 PM" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="actLocationInput">Location Label *</label>
              <input type="text" id="actLocationInput" class="form-input" placeholder="e.g., Indoor Sports Complex" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="actDescInput">Description & What to Bring *</label>
            <textarea id="actDescInput" class="form-textarea" rows="3" placeholder="Explain the plan, expected skill levels, and what to bring..." required minlength="15"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="app.closeModal('modalCreateActivity')">Cancel</button>
          <button type="submit" class="btn btn-primary">Publish Activity</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================================================
       MODAL 3: EDIT PROFILE & INTERESTS
       ======================================================================== -->
  <div class="modal-overlay" id="modalEditProfile" onclick="if(event.target === this) app.closeModal('modalEditProfile')">
    <div class="modal-box" role="dialog" aria-labelledby="modalEditProfileTitle">
      <div class="modal-header">
        <h3 class="modal-title" id="modalEditProfileTitle">Edit Demo Profile & Interests</h3>
        <button class="btn-modal-close" aria-label="Close modal" onclick="app.closeModal('modalEditProfile')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <form id="formEditProfile" onsubmit="app.handleProfileSave(event)">
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="editNameInput">Full Name *</label>
            <input type="text" id="editNameInput" class="form-input" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="editMajorInput">Major / Department & Year *</label>
            <input type="text" id="editMajorInput" class="form-input" placeholder="e.g., Computer Science · 2nd Year" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="editBioInput">Short Bio *</label>
            <textarea id="editBioInput" class="form-textarea" rows="3" required></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Select Your Interests (Click to toggle)</label>
            <div class="interest-pill-select" id="modalInterestPills">
              <!-- Injected by JavaScript -->
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="app.closeModal('modalEditProfile')">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Profile Changes</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================================================
       TOAST CONTAINER
