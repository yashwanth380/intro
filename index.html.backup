    <!-- ======================================================================
         VIEW 3: ALL COMMUNITIES DIRECTORY
         ====================================================================== -->
    <section id="view-communities" class="view-section">
      <div class="container communities-container">
        <div class="view-header">
          <h2 class="view-title">Campus Communities</h2>
          <p class="view-subtitle">Join student-run groups, share resources, participate in discussions, and meet your peers.</p>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="toolbar-bar">
          <div class="search-wrapper">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="communitySearchInput" class="search-input" placeholder="Search communities by name, topic or tag..." oninput="app.filterCommunities()">
          </div>

          <div class="filter-pills" id="communityFilterPills">
            <button class="filter-pill active" onclick="app.setCommunityCategory('All', this)">All (10)</button>
            <button class="filter-pill" onclick="app.setCommunityCategory('Academics', this)">Academics</button>
            <button class="filter-pill" onclick="app.setCommunityCategory('Technology', this)">Technology</button>
            <button class="filter-pill" onclick="app.setCommunityCategory('Arts & Culture', this)">Arts & Culture</button>
            <button class="filter-pill" onclick="app.setCommunityCategory('Recreation', this)">Recreation</button>
            <button class="filter-pill" onclick="app.setCommunityCategory('Athletics', this)">Athletics</button>
            <button class="filter-pill" onclick="app.setCommunityCategory('Social', this)">Social</button>
          </div>
        </div>

        <!-- Communities Grid -->
        <div class="communities-grid" id="allCommunitiesGrid">
          <!-- Injected by JavaScript -->
        </div>

        <div id="noCommunitiesFound" class="empty-state" style="display: none;">
          <div class="empty-icon">🔍</div>
          <div class="empty-title">No communities match your search</div>
          <div class="empty-text">Try adjusting your keyword or reset filters to explore all 10 campus communities.</div>
          <button class="btn btn-primary btn-sm" style="margin-top: 1rem;" onclick="app.resetCommunityFilters()">Reset Filters</button>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         VIEW 3.5: COMMUNITY DETAIL / ACTIVE FEED VIEW
         ====================================================================== -->
    <section id="view-community-detail" class="view-section">
      <div class="container community-detail-container">
        <div class="breadcrumb-bar">
          <button class="btn-back" onclick="app.navigate('communities')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            <span>Back to All Communities</span>
          </button>
        </div>

        <!-- Community Hero Banner -->
        <div class="community-hero-banner" id="communityHeroBanner">
          <div class="community-hero-left">
            <div class="community-hero-icon" id="detailHeroIcon">💻</div>
            <div>
              <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom: 0.35rem;">
                <span class="badge badge-indigo" id="detailHeroCategory">Technology</span>
                <span class="badge badge-slate" id="detailHeroMemberBadge">485 Members</span>
              </div>
              <h2 class="community-hero-title" id="detailHeroTitle">Coding Community</h2>
              <p class="community-hero-sub" id="detailHeroDesc">Collaborate on open source, practice DSA, build hackathon projects, and ask tech questions.</p>
            </div>
          </div>
          <div class="community-hero-actions">
            <button id="detailJoinBtn" class="btn btn-primary" onclick="app.toggleJoinActiveCommunity()">
              <span>Join Community</span>
            </button>
          </div>
        </div>

        <!-- Community Detail Layout -->
        <div class="community-detail-layout">
          <!-- Main Feed Column -->
          <div class="community-feed-col">
            <!-- Composer -->
            <div class="composer-card">
              <div class="composer-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                <span>Share a thought or start a discussion</span>
              </div>
              <textarea id="communityPostInput" class="composer-textarea" placeholder="What's happening on your mind? Ask a question, share a tip or resource..." rows="3"></textarea>
              <div class="composer-actions">
                <span class="composer-hint">💡 Be respectful and friendly to fellow peers.</span>
                <button class="btn btn-primary btn-sm" onclick="app.postCommunityMessage()">
                  <span>Post to Feed</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
              </div>
            </div>

            <!-- Feed List -->
            <div class="feed-card">
              <div class="feed-header">
                <span>Discussion Feed</span>
                <span style="font-size: 0.8rem; font-weight: 500; color: var(--slate-500);" id="feedMessageCount">3 messages</span>
              </div>
              <div class="feed-message-list" id="communityMessageList">
                <!-- Injected by JavaScript -->
              </div>
            </div>
          </div>

          <!-- Sidebar Column: Guidelines, Members & Related -->
          <div class="community-sidebar-col">
            <!-- Community Guidelines -->
            <div class="sidebar-widget">
              <h4 class="widget-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Community Guidelines</span>
              </h4>
              <div class="guidelines-checklist" id="detailGuidelinesList">
                <!-- Injected by JavaScript -->
              </div>
            </div>

            <!-- Sample Members -->
            <div class="sidebar-widget">
              <h4 class="widget-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                <span>Sample Members</span>
              </h4>
              <div class="members-mini-list" id="detailMembersList">
                <!-- Injected by JavaScript -->
              </div>
            </div>

            <!-- Related Communities -->
            <div class="sidebar-widget">
              <h4 class="widget-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                <span>Related Communities</span>
              </h4>
              <div id="detailRelatedList">
                <!-- Injected by JavaScript -->
              </div>
            </div>
          </div>
        </div>
      </div>
