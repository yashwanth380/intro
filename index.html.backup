      const DEFAULT_DOUBTS = [
        {
          id: 'd1',
          title: 'How does Floyd-Warshall algorithm handle negative edge cycles?',
          subject: 'Computer Science',
          author: 'Kavita Das',
          time: '3 hours ago',
          desc: 'I understand that Floyd-Warshall calculates all-pairs shortest paths via dynamic programming. But how do we detect negative cycles? Does it show up as negative values along the diagonal dist[i][i]?',
          tags: ['algorithms', 'dynamic-programming', 'graphs'],
          solved: true,
          answers: [
            {
              id: 'a1',
              author: 'Devon Vance (Peer Tutor)',
              time: '2 hours ago',
              text: 'Yes, exactly! If after running the V iterations there exists any node i where dist[i][i] < 0, a negative cycle exists that passes through node i. Because the shortest path from a node to itself is initially 0, any reduction indicates a cycle with net negative weight.',
              helpfulCount: 16,
              hasVotedHelpful: false
            }
          ]
        },
        {
          id: 'd2',
          title: 'Intuitive geometric explanation for Eigenvalues and Eigenvectors?',
          subject: 'Mathematics',
          author: 'Alex Rivera',
          time: 'Yesterday',
          desc: 'Can someone explain eigenvectors without just writing Av = λv? When transforming a vector space with a matrix, what physically happens along the eigenvector direction?',
          tags: ['linear-algebra', 'matrices', 'geometry'],
          solved: true,
          answers: [
            {
              id: 'a2',
              author: 'Ananya Roy',
              time: 'Yesterday',
              text: 'Think of matrix multiplication as stretching and rotating 2D space. Most vectors change both their magnitude and their direction. But along eigenvectors, the direction never changes — the vector is only scaled (stretched or shrunk) by the factor λ. It acts like a stationary axis of the transformation!',
              helpfulCount: 28,
              hasVotedHelpful: true
            }
          ]
        },
        {
          id: 'd3',
          title: 'RC Circuit step response time constant derivation question',
          subject: 'Electronics',
          author: 'Rohan Verma',
          time: '2 days ago',
          desc: 'Why is τ = RC considered to reach 63.2% of final value during charging? Where does that specific 63.2% figure mathematically originate?',
          tags: ['circuits', 'electronics', 'derivation'],
          solved: false,
          answers: [
            {
              id: 'a3',
              author: 'Carlos Mendez',
              time: '1 day ago',
              text: 'The voltage formula during capacitor charging is V(t) = V_max * (1 - e^(-t / RC)). When t = RC, this evaluates to V_max * (1 - e^(-1)). Since 1/e ≈ 0.368, 1 - 0.368 = 0.632, which is 63.2%!',
              helpfulCount: 11,
              hasVotedHelpful: false
            }
          ]
        }
      ];

