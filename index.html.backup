      // ----------------------------------------------------------------------
      // 2. LOCAL STORAGE PERSISTENCE HELPERS
      // ----------------------------------------------------------------------
      const STORAGE_KEY = 'campus_connect_data_v1';

      function loadState() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            return {
              communities: parsed.communities || DEFAULT_COMMUNITIES,
              doubts: parsed.doubts || DEFAULT_DOUBTS,
              activities: parsed.activities || DEFAULT_ACTIVITIES,
              profile: parsed.profile || DEFAULT_PROFILE
            };
          }
        } catch (e) {
          console.warn('LocalStorage unavailable or corrupted. Using defaults.', e);
        }
        return {
          communities: DEFAULT_COMMUNITIES,
          doubts: DEFAULT_DOUBTS,
          activities: DEFAULT_ACTIVITIES,
          profile: DEFAULT_PROFILE
        };
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            communities: state.communities,
            doubts: state.doubts,
            activities: state.activities,
            profile: state.profile
          }));
        } catch (e) {
          console.warn('Unable to write to LocalStorage.', e);
        }
      }

      const state = loadState();
      let activeCommunityId = null;
      let communityCategoryFilter = 'All';
      let doubtSubjectFilter = 'All';
      let activityCategoryFilter = 'All';

      // ----------------------------------------------------------------------
      // 3. UTILITY FUNCTIONS
      // ----------------------------------------------------------------------
      function escapeHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function showToast(message, type = 'success') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        
        let iconSvg = '';
        if (type === 'success') {
          iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        } else if (type === 'info') {
          iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
        } else {
          iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
        }

        toast.innerHTML = `${iconSvg}<span>${escapeHtml(message)}</span>`;
        container.appendChild(toast);

        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(15px)';
          toast.style.transition = 'all 0.25s ease';
          setTimeout(() => {
            if (typeof toast.remove === 'function') {
              toast.remove();
            } else if (toast.parentNode) {
              toast.parentNode.removeChild(toast);
            }
          }, 250);
        }, 3400);
      }

      // ----------------------------------------------------------------------
      // 4. ROUTING & VIEW NAVIGATION
      // ----------------------------------------------------------------------
      function navigate(viewName) {
        window.scrollTo({ top: 0, behavior: 'smooth' });

        // Update nav links active state
        document.querySelectorAll('.nav-link').forEach(link => {
          if (link.dataset.view === viewName) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });

        // Toggle view visibility
        document.querySelectorAll('.view-section').forEach(sec => {
          sec.classList.remove('active');
        });

        const targetSection = document.getElementById(`view-${viewName}`);
        if (targetSection) {
          targetSection.classList.add('active');
        }

        // Render contents specific to active view
        if (viewName === 'landing') {
          renderLandingFeatured();
        } else if (viewName === 'dashboard') {
          renderDashboard();
        } else if (viewName === 'communities') {
          renderCommunities();
        } else if (viewName === 'doubts') {
          renderDoubts();
        } else if (viewName === 'activities') {
          renderActivities();
        } else if (viewName === 'profile') {
          renderProfile();
        }

        // Update URL hash safely without reload
        if (typeof window !== 'undefined' && window.history && window.history.pushState) {
          window.history.pushState(null, null, `#${viewName}`);
        }
      }

      function scrollToSection(elemId) {
        const el = document.getElementById(elemId);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth' });
        }
      }

      function toggleMobileMenu(open) {
        const drawer = document.getElementById('mobileDrawer');
        if (open) {
          drawer.classList.add('open');
        } else {
          drawer.classList.remove('open');
        }
      }

      // ----------------------------------------------------------------------
      // 5. LANDING PAGE RENDERING
      // ----------------------------------------------------------------------
      function renderLandingFeatured() {
        const container = document.getElementById('landingFeaturedCommunities');
        if (!container) return;
        const featured = state.communities.slice(0, 3);
        
        container.innerHTML = featured.map(c => {
          const isJoined = state.profile.joinedCommunityIds.includes(c.id);
          return `
            <div class="community-card">
              <div>
                <div class="community-card-top">
                  <div class="community-card-icon">${c.icon}</div>
                  <span class="badge badge-indigo">${escapeHtml(c.category)}</span>
                </div>
                <h3 class="community-card-name">${escapeHtml(c.name)}</h3>
                <p class="community-card-desc">${escapeHtml(c.desc)}</p>
                <div class="community-card-tags">
                  ${c.tags.slice(0, 3).map(t => `<span class="mini-tag" style="background:var(--slate-100); color:var(--slate-700);">#${escapeHtml(t)}</span>`).join('')}
                </div>
              </div>
              <div class="community-card-footer">
                <span class="community-card-members">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                  ${c.memberCount} members
                </span>
                <button class="btn ${isJoined ? 'btn-joined' : 'btn-primary'} btn-sm" onclick="app.openCommunityDetail('${c.id}')">
                  <span>${isJoined ? 'Joined ✓' : 'Explore'}</span>
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      // ----------------------------------------------------------------------
      // 6. DASHBOARD RENDERING
      // ----------------------------------------------------------------------
      function renderDashboard() {
        document.getElementById('dashWelcomeName').textContent = state.profile.name.split(' ')[0] || 'Student';
        document.getElementById('statJoinedCount').textContent = state.profile.joinedCommunityIds.length;
        document.getElementById('statDoubtsCount').textContent = state.doubts.length;
        
        const myActivitiesCount = state.activities.filter(a => a.joined).length;
        document.getElementById('statActivitiesCount').textContent = myActivitiesCount;

        // Joined Communities List
        const joinedContainer = document.getElementById('dashJoinedCommunitiesList');
        const joined = state.communities.filter(c => state.profile.joinedCommunityIds.includes(c.id));
        
        if (joined.length === 0) {
          joinedContainer.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 2rem; color: var(--slate-500); font-size: 0.9rem;">
              You have not joined any communities yet. 
              <br><button class="btn btn-outline btn-sm" style="margin-top: 0.75rem;" onclick="app.navigate('communities')">Explore Communities</button>
            </div>
          `;
        } else {
          joinedContainer.innerHTML = joined.map(c => `
            <div class="joined-mini-card" onclick="app.openCommunityDetail('${c.id}')">
              <div>
                <div class="joined-mini-head">
                  <span class="mini-icon">${c.icon}</span>
                  <span class="joined-mini-name">${escapeHtml(c.name)}</span>
                </div>
                <p class="joined-mini-desc">${escapeHtml(c.desc.slice(0, 75))}...</p>
              </div>
              <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.75rem; color:var(--indigo-600); font-weight:600;">
                <span>${c.messages.length} recent messages</span>
                <span>Enter →</span>
              </div>
            </div>
          `).join('');
        }

        // Trending Discussions
        const trendingContainer = document.getElementById('dashTrendingDiscussions');
        const allMsgs = [];
        state.communities.forEach(c => {
          c.messages.forEach(m => {
            allMsgs.push({ ...m, communityName: c.name, communityId: c.id });
          });
        });

        const trendingList = allMsgs.slice(0, 3);
        trendingContainer.innerHTML = trendingList.map(m => `
          <div class="dash-discussion-item" style="cursor: pointer;" onclick="app.openCommunityDetail('${m.communityId}')">
            <div class="discussion-item-top">
              <div class="discussion-meta-left">
                <span class="discussion-author">${escapeHtml(m.author)}</span>
                <span class="badge badge-indigo" style="font-size:0.65rem;">${escapeHtml(m.communityName)}</span>
              </div>
              <span class="discussion-time">${escapeHtml(m.time)}</span>
            </div>
            <p class="discussion-item-snippet">"${escapeHtml(m.text)}"</p>
            <div class="discussion-item-footer">
              <span>❤️ ${m.likes} peer reactions</span>
              <span style="color:var(--indigo-600); font-weight:600;">Open Discussion →</span>
            </div>
          </div>
        `).join('');

        // Recommended Communities
        const recContainer = document.getElementById('dashRecommendedList');
        const unjoined = state.communities.filter(c => !state.profile.joinedCommunityIds.includes(c.id)).slice(0, 3);
        
        if (unjoined.length === 0) {
          recContainer.innerHTML = `<p style="font-size: 0.85rem; color: var(--slate-500); padding: 0.5rem 0;">You're part of every campus community! Outstanding!</p>`;
        } else {
          recContainer.innerHTML = unjoined.map(c => `
            <div class="rec-item">
              <div class="rec-left">
                <div class="rec-icon">${c.icon}</div>
                <div>
                  <div class="rec-title">${escapeHtml(c.name)}</div>
                  <div class="rec-sub">${c.memberCount} members · ${escapeHtml(c.category)}</div>
                </div>
              </div>
              <button class="btn btn-outline btn-sm" onclick="app.toggleJoinCommunity('${c.id}', event)">Join</button>
            </div>
          `).join('');
        }

        // Upcoming Activities
        const upActivitiesContainer = document.getElementById('dashUpcomingActivitiesList');
        const upActs = state.activities.slice(0, 2);
        upActivitiesContainer.innerHTML = upActs.map(a => `
          <div style="padding: 0.75rem 0; border-bottom: 1px solid var(--slate-100);">
            <div style="font-weight: 700; font-size: 0.9rem; color: var(--navy-900);">${escapeHtml(a.title)}</div>
            <div style="font-size: 0.8rem; color: var(--slate-500); margin-top: 0.2rem;">📍 ${escapeHtml(a.location)}</div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top: 0.4rem;">
              <span style="font-size: 0.75rem; color: var(--indigo-600); font-weight:600;">${escapeHtml(a.date)}</span>
              <button class="btn ${a.joined ? 'btn-joined' : 'btn-outline'} btn-sm" onclick="app.toggleActivityRSVP('${a.id}')">
                ${a.joined ? 'RSVP’d ✓' : 'RSVP'}
              </button>
            </div>
          </div>
        `).join('');

        // Discover Interests Tag Cloud
        const cloudContainer = document.getElementById('dashInterestCloud');
        cloudContainer.innerHTML = ALL_AVAILABLE_INTERESTS.map(tag => `
          <button class="interactive-tag ${state.profile.interests.includes(tag) ? 'selected' : ''}" onclick="app.filterByInterestTag('${tag}')">
            #${escapeHtml(tag)}
          </button>
        `).join('');
      }

      function filterByInterestTag(tag) {
        navigate('communities');
        const searchInput = document.getElementById('communitySearchInput');
        if (searchInput) {
          searchInput.value = tag;
          filterCommunities();
        }
      }

      // ----------------------------------------------------------------------
      // 7. COMMUNITIES DIRECTORY
      // ----------------------------------------------------------------------
      function renderCommunities() {
        const grid = document.getElementById('allCommunitiesGrid');
        const noFound = document.getElementById('noCommunitiesFound');
        const query = (document.getElementById('communitySearchInput')?.value || '').toLowerCase().trim();

        const filtered = state.communities.filter(c => {
          const matchCat = communityCategoryFilter === 'All' || c.category === communityCategoryFilter;
          const matchQuery = !query || 
            c.name.toLowerCase().includes(query) ||
            c.desc.toLowerCase().includes(query) ||
            c.tags.some(t => t.toLowerCase().includes(query));
          return matchCat && matchQuery;
        });

        if (filtered.length === 0) {
          grid.innerHTML = '';
          noFound.style.display = 'block';
          return;
        }

        noFound.style.display = 'none';
        grid.innerHTML = filtered.map(c => {
          const isJoined = state.profile.joinedCommunityIds.includes(c.id);
          return `
            <div class="community-card">
              <div>
                <div class="community-card-top">
                  <div class="community-card-icon">${c.icon}</div>
                  <span class="badge badge-indigo">${escapeHtml(c.category)}</span>
                </div>
                <h3 class="community-card-name">${escapeHtml(c.name)}</h3>
                <p class="community-card-desc">${escapeHtml(c.desc)}</p>
                <div class="community-card-tags">
                  ${c.tags.map(t => `<span class="mini-tag" style="background:var(--slate-100); color:var(--slate-700);">#${escapeHtml(t)}</span>`).join('')}
                </div>
              </div>

              <div class="community-card-footer">
                <span class="community-card-members">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                  ${c.memberCount} members
                </span>
                <div style="display:flex; gap:0.5rem;">
                  <button class="btn ${isJoined ? 'btn-joined' : 'btn-outline'} btn-sm" onclick="app.toggleJoinCommunity('${c.id}', event)">
                    ${isJoined ? 'Joined ✓' : 'Join'}
                  </button>
                  <button class="btn btn-primary btn-sm" onclick="app.openCommunityDetail('${c.id}')">
                    <span>Enter</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      function filterCommunities() {
        renderCommunities();
      }

      function setCommunityCategory(cat, btn) {
        communityCategoryFilter = cat;
        document.querySelectorAll('#communityFilterPills .filter-pill').forEach(p => p.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderCommunities();
      }

      function resetCommunityFilters() {
        const input = document.getElementById('communitySearchInput');
        if (input) input.value = '';
        communityCategoryFilter = 'All';
        const pills = document.querySelectorAll('#communityFilterPills .filter-pill');
        pills.forEach((p, idx) => {
          if (idx === 0) p.classList.add('active');
          else p.classList.remove('active');
        });
        renderCommunities();
      }

      function toggleJoinCommunity(id, ev) {
        if (ev) ev.stopPropagation();
        const index = state.profile.joinedCommunityIds.indexOf(id);
        const comm = state.communities.find(c => c.id === id);

        if (index > -1) {
          state.profile.joinedCommunityIds.splice(index, 1);
          if (comm) comm.memberCount = Math.max(0, comm.memberCount - 1);
          showToast(`Left ${comm ? comm.name : 'community'}.`, 'info');
        } else {
          state.profile.joinedCommunityIds.push(id);
          if (comm) comm.memberCount += 1;
          showToast(`Joined ${comm ? comm.name : 'community'}! 🎉`, 'success');
        }

        saveState();
        renderCommunities();
        updateNavUser();
      }

      // ----------------------------------------------------------------------
      // 8. COMMUNITY DETAIL VIEW & FEED
      // ----------------------------------------------------------------------
      function openCommunityDetail(id) {
        activeCommunityId = id;
        const comm = state.communities.find(c => c.id === id);
        if (!comm) return;

        window.scrollTo({ top: 0, behavior: 'smooth' });

        // Switch to detail section
        document.querySelectorAll('.view-section').forEach(sec => sec.classList.remove('active'));
        document.getElementById('view-community-detail').classList.add('active');

        // Populate Hero
        document.getElementById('detailHeroIcon').textContent = comm.icon;
        document.getElementById('detailHeroTitle').textContent = comm.name;
        document.getElementById('detailHeroCategory').textContent = comm.category;
        document.getElementById('detailHeroMemberBadge').textContent = `${comm.memberCount} Members`;
        document.getElementById('detailHeroDesc').textContent = comm.desc;

        const isJoined = state.profile.joinedCommunityIds.includes(comm.id);
        const joinBtn = document.getElementById('detailJoinBtn');
        if (isJoined) {
          joinBtn.className = 'btn btn-joined';
          joinBtn.innerHTML = '<span>Joined ✓ (Click to Leave)</span>';
        } else {
          joinBtn.className = 'btn btn-primary';
          joinBtn.innerHTML = '<span>Join Community</span>';
        }

        // Render Guidelines
        const guidelinesList = document.getElementById('detailGuidelinesList');
        guidelinesList.innerHTML = comm.guidelines.map(g => `
          <div class="guideline-check-item">
            <svg class="guideline-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>${escapeHtml(g)}</span>
          </div>
        `).join('');

        // Render Sample Members
        const membersList = document.getElementById('detailMembersList');
        membersList.innerHTML = comm.members.map(m => `
          <div class="member-row">
            <div class="avatar-sm" style="background: linear-gradient(135deg, #6366f1, #a855f7);">${m.avatar}</div>
            <div>
              <div class="member-info-name">${escapeHtml(m.name)}</div>
              <div class="member-info-role">${escapeHtml(m.role)}</div>
            </div>
          </div>
        `).join('');

        // Render Related Communities
        const relatedList = document.getElementById('detailRelatedList');
        const related = state.communities.filter(c => comm.relatedIds && comm.relatedIds.includes(c.id));
        relatedList.innerHTML = related.map(rc => `
          <div style="display:flex; align-items:center; justify-content:space-between; padding:0.6rem 0; border-bottom:1px solid var(--slate-100);">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span>${rc.icon}</span>
              <span style="font-size:0.875rem; font-weight:600; color:var(--navy-900);">${escapeHtml(rc.name)}</span>
            </div>
            <button class="btn btn-outline btn-sm" onclick="app.openCommunityDetail('${rc.id}')">View</button>
          </div>
        `).join('');

        renderCommunityMessages(comm);
      }

      function toggleJoinActiveCommunity() {
        if (!activeCommunityId) return;
        toggleJoinCommunity(activeCommunityId);
        openCommunityDetail(activeCommunityId);
      }

      function renderCommunityMessages(comm) {
        const msgList = document.getElementById('communityMessageList');
        const countBadge = document.getElementById('feedMessageCount');
        countBadge.textContent = `${comm.messages.length} message${comm.messages.length === 1 ? '' : 's'}`;

        if (comm.messages.length === 0) {
          msgList.innerHTML = `
            <div style="text-align: center; padding: 2rem; color: var(--slate-500); font-size: 0.9rem;">
              No messages yet in this community. Be the first to start the conversation!
            </div>
          `;
          return;
        }

        msgList.innerHTML = comm.messages.map(m => `
          <div class="feed-message-item">
            <div class="avatar-sm" style="flex-shrink:0;">${m.author.split(' ').map(n=>n[0]).join('')}</div>
            <div class="feed-message-content">
              <div class="feed-author-line">
                <span class="feed-author-name">${escapeHtml(m.author)}</span>
                <span class="feed-author-role">${escapeHtml(m.role || 'Member')}</span>
                <span class="feed-time">${escapeHtml(m.time)}</span>
              </div>
              <p class="feed-text">${escapeHtml(m.text)}</p>
              <div class="feed-msg-actions">
                <button class="btn-heart-reaction ${m.liked ? 'liked' : ''}" onclick="app.toggleLikeMessage('${comm.id}', '${m.id}')">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="${m.liked ? '#f43f5e' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                  <span>${m.likes}</span>
                </button>
              </div>
            </div>
          </div>
        `).join('');
      }

      function postCommunityMessage() {
        if (!activeCommunityId) return;
        const input = document.getElementById('communityPostInput');
        const text = (input?.value || '').trim();

        if (!text) {
          showToast('Please type a message before posting.', 'warning');
          return;
        }

        const comm = state.communities.find(c => c.id === activeCommunityId);
        if (!comm) return;

        const newMsg = {
          id: 'msg_' + Date.now(),
          author: state.profile.name,
          role: 'Student Member',
          time: 'Just now',
          text: text,
          likes: 1,
          liked: true
        };

        comm.messages.unshift(newMsg);
        input.value = '';
        saveState();
        renderCommunityMessages(comm);
        showToast('Message posted to community feed! 🚀', 'success');
      }

      function toggleLikeMessage(commId, msgId) {
        const comm = state.communities.find(c => c.id === commId);
        if (!comm) return;
        const msg = comm.messages.find(m => m.id === msgId);
        if (!msg) return;

        if (msg.liked) {
          msg.liked = false;
          msg.likes = Math.max(0, msg.likes - 1);
        } else {
          msg.liked = true;
          msg.likes += 1;
        }

        saveState();
        renderCommunityMessages(comm);
      }

      // ----------------------------------------------------------------------
      // 9. DOUBT SOLVING (ACADEMIC Q&A)
      // ----------------------------------------------------------------------
      function renderDoubts() {
        const container = document.getElementById('doubtsListContainer');
        const noFound = document.getElementById('noDoubtsFound');
        const query = (document.getElementById('doubtSearchInput')?.value || '').toLowerCase().trim();

        const filtered = state.doubts.filter(d => {
          const matchSub = doubtSubjectFilter === 'All' || d.subject === doubtSubjectFilter;
          const matchQuery = !query ||
            d.title.toLowerCase().includes(query) ||
            d.desc.toLowerCase().includes(query) ||
            d.tags.some(t => t.toLowerCase().includes(query));
          return matchSub && matchQuery;
        });

        if (filtered.length === 0) {
          container.innerHTML = '';
          noFound.style.display = 'block';
          return;
        }

        noFound.style.display = 'none';
        container.innerHTML = filtered.map(d => `
          <div class="doubt-card">
            <div class="doubt-card-top">
              <div>
                <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom: 0.4rem;">
                  <span class="badge badge-indigo">${escapeHtml(d.subject)}</span>
                  ${d.solved ? '<span class="badge badge-emerald">Solved ✓</span>' : '<span class="badge badge-amber">Open Question</span>'}
                </div>
                <h3 class="doubt-question-title">${escapeHtml(d.title)}</h3>
              </div>
            </div>

            <p class="doubt-body-text">${escapeHtml(d.desc)}</p>

            <div class="doubt-tags">
              ${d.tags.map(t => `<span class="mini-tag" style="background:var(--slate-100); color:var(--slate-700);">#${escapeHtml(t)}</span>`).join('')}
            </div>

            <div class="doubt-footer">
              <div class="doubt-author-meta">
                <div class="avatar-sm" style="width:26px; height:26px; font-size:0.7rem;">${d.author.split(' ').map(n=>n[0]).join('')}</div>
                <span>Asked by <strong>${escapeHtml(d.author)}</strong> · ${escapeHtml(d.time)}</span>
              </div>

              <div class="doubt-actions-cluster">
                <button class="btn-toggle-answers" onclick="app.toggleAnswersSection('${d.id}')">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                  <span>${d.answers.length} Answer${d.answers.length === 1 ? '' : 's'}</span>
                </button>
              </div>
            </div>

            <!-- Expandable Answers Container -->
            <div class="answers-container" id="answers-for-${d.id}">
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--navy-900); margin-bottom: 0.75rem;">
                Peer Answers (${d.answers.length})
              </div>

              ${d.answers.length === 0 ? '<div style="color:var(--slate-500); font-size:0.875rem; margin-bottom:1rem;">No answers yet. Be the first to explain!</div>' : ''}

              ${d.answers.map(ans => `
                <div class="answer-item">
                  <div class="answer-top">
                    <div class="answer-author">
                      <div class="avatar-sm" style="width:24px; height:24px; font-size:0.65rem; background:#4f46e5;">${ans.author.split(' ').map(n=>n[0]).join('')}</div>
                      <span>${escapeHtml(ans.author)}</span>
                    </div>
                    <span style="font-size:0.75rem; color:var(--slate-400);">${escapeHtml(ans.time)}</span>
                  </div>
                  <p class="answer-text">${escapeHtml(ans.text)}</p>
                  <button class="btn-helpful ${ans.hasVotedHelpful ? 'voted' : ''}" onclick="app.voteAnswerHelpful('${d.id}', '${ans.id}')">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>Helpful (${ans.helpfulCount})</span>
                  </button>
                </div>
              `).join('')}

              <!-- Write Answer Box -->
              <div class="write-answer-box">
                <label style="display:block; font-size:0.825rem; font-weight:600; color:var(--navy-900); margin-bottom:0.35rem;">Post an Answer / Explanation</label>
                <textarea id="reply-input-${d.id}" class="composer-textarea" rows="2" placeholder="Write a step-by-step peer explanation..."></textarea>
                <div style="display:flex; justify-content:flex-end;">
                  <button class="btn btn-primary btn-sm" onclick="app.submitAnswer('${d.id}')">Submit Answer</button>
                </div>
              </div>
            </div>
          </div>
        `).join('');
      }

      function filterDoubts() {
        renderDoubts();
      }

      function setDoubtSubject(subj, btn) {
        doubtSubjectFilter = subj;
        document.querySelectorAll('#doubtSubjectPills .filter-pill').forEach(p => p.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderDoubts();
      }

      function toggleAnswersSection(doubtId) {
        const sec = document.getElementById(`answers-for-${doubtId}`);
        if (sec) {
          sec.classList.toggle('open');
        }
      }

      function voteAnswerHelpful(doubtId, answerId) {
        const doubt = state.doubts.find(d => d.id === doubtId);
        if (!doubt) return;
        const ans = doubt.answers.find(a => a.id === answerId);
        if (!ans) return;

        if (ans.hasVotedHelpful) {
          ans.hasVotedHelpful = false;
          ans.helpfulCount = Math.max(0, ans.helpfulCount - 1);
        } else {
          ans.hasVotedHelpful = true;
          ans.helpfulCount += 1;
          showToast('Marked as helpful! Thanks for encouraging peer help.', 'success');
        }

        saveState();
        renderDoubts();
        // Keep answer section open
        const sec = document.getElementById(`answers-for-${doubtId}`);
        if (sec) sec.classList.add('open');
      }

      function submitAnswer(doubtId) {
        const input = document.getElementById(`reply-input-${doubtId}`);
        const text = (input?.value || '').trim();

        if (!text) {
          showToast('Please type an answer before submitting.', 'warning');
          return;
        }

        const doubt = state.doubts.find(d => d.id === doubtId);
        if (!doubt) return;

        const newAns = {
          id: 'ans_' + Date.now(),
          author: state.profile.name,
          time: 'Just now',
          text: text,
          helpfulCount: 1,
          hasVotedHelpful: true
        };

        doubt.answers.push(newAns);
        doubt.solved = true;
        saveState();
        renderDoubts();

        const sec = document.getElementById(`answers-for-${doubtId}`);
        if (sec) sec.classList.add('open');
        showToast('Your answer has been published! 🌟', 'success');
      }

      function openAskDoubtModal() {
        document.getElementById('modalAskDoubt').classList.add('open');
        document.getElementById('doubtTitleInput').focus();
      }

      function handleDoubtSubmit(event) {
        event.preventDefault();
        const title = document.getElementById('doubtTitleInput').value.trim();
        const subject = document.getElementById('doubtSubjectSelect').value;
        const desc = document.getElementById('doubtDescInput').value.trim();
        const tagsRaw = document.getElementById('doubtTagsInput').value.trim();

        if (title.length < 10) {
          document.getElementById('doubtTitleError').classList.add('visible');
          return;
        } else {
          document.getElementById('doubtTitleError').classList.remove('visible');
        }

        if (desc.length < 20) {
          document.getElementById('doubtDescError').classList.add('visible');
          return;
        } else {
          document.getElementById('doubtDescError').classList.remove('visible');
        }

        const tags = tagsRaw
          ? tagsRaw.split(',').map(t => t.trim().toLowerCase().replace(/[^a-z0-9_-]/g, '')).filter(Boolean)
          : ['question', subject.toLowerCase().replace(/\s+/g, '-')];

        const newDoubt = {
          id: 'doubt_' + Date.now(),
          title: title,
          subject: subject,
          author: state.profile.name,
          time: 'Just now',
          desc: desc,
          tags: tags,
          solved: false,
          answers: []
        };

        state.doubts.unshift(newDoubt);
        saveState();

        document.getElementById('formAskDoubt').reset();
        closeModal('modalAskDoubt');
        navigate('doubts');
        showToast('Your doubt was posted successfully! 💡', 'success');
      }

      // ----------------------------------------------------------------------
      // 10. CAMPUS ACTIVITIES
      // ----------------------------------------------------------------------
      function renderActivities() {
        const grid = document.getElementById('activitiesGrid');
        const noFound = document.getElementById('noActivitiesFound');
        const query = (document.getElementById('activitySearchInput')?.value || '').toLowerCase().trim();

        const filtered = state.activities.filter(a => {
          const matchCat = activityCategoryFilter === 'All' || a.category === activityCategoryFilter;
          const matchQuery = !query ||
            a.title.toLowerCase().includes(query) ||
            a.location.toLowerCase().includes(query) ||
            a.desc.toLowerCase().includes(query);
          return matchCat && matchQuery;
        });

        if (filtered.length === 0) {
          grid.innerHTML = '';
          noFound.style.display = 'block';
          return;
        }

        noFound.style.display = 'none';
        grid.innerHTML = filtered.map(a => `
          <div class="activity-card">
            <div>
              <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div class="activity-date-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg>
                  <span>${escapeHtml(a.date)}</span>
                </div>
                ${a.isUserCreated ? '<span class="badge badge-emerald">Created by You</span>' : `<span class="badge badge-indigo">${escapeHtml(a.category)}</span>`}
              </div>

              <h3 class="activity-card-title">${escapeHtml(a.title)}</h3>
              <div class="activity-location">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>${escapeHtml(a.location)}</span>
              </div>
              <p class="activity-desc">${escapeHtml(a.desc)}</p>
            </div>

            <div class="activity-card-footer">
              <span class="attendees-pill">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                ${a.attendeesCount} students attending
              </span>
              <button class="btn ${a.joined ? 'btn-joined' : 'btn-primary'} btn-sm" onclick="app.toggleActivityRSVP('${a.id}')">
                ${a.joined ? 'RSVP’d ✓ (Cancel)' : 'Join Activity'}
              </button>
            </div>
          </div>
        `).join('');
      }

      function filterActivities() {
        renderActivities();
      }

      function setActivityCategory(cat, btn) {
        activityCategoryFilter = cat;
        document.querySelectorAll('#activityCategoryPills .filter-pill').forEach(p => p.classList.remove('active'));
        if (btn) btn.classList.add('active');
        renderActivities();
      }

      function toggleActivityRSVP(actId) {
        const act = state.activities.find(a => a.id === actId);
        if (!act) return;

        if (act.joined) {
          act.joined = false;
          act.attendeesCount = Math.max(0, act.attendeesCount - 1);
          showToast(`Cancelled RSVP for "${act.title}".`, 'info');
        } else {
          act.joined = true;
          act.attendeesCount += 1;
          showToast(`RSVP Confirmed for "${act.title}"! See you there 🎉`, 'success');
        }

        saveState();
        renderActivities();
        if (document.getElementById('view-dashboard').classList.contains('active')) {
          renderDashboard();
        }
      }

      function openCreateActivityModal() {
        document.getElementById('modalCreateActivity').classList.add('open');
        document.getElementById('actTitleInput').focus();
      }

      function handleActivitySubmit(event) {
        event.preventDefault();
        const title = document.getElementById('actTitleInput').value.trim();
        const category = document.getElementById('actCategorySelect').value;
        const date = document.getElementById('actDateInput').value.trim();
        const location = document.getElementById('actLocationInput').value.trim();
        const desc = document.getElementById('actDescInput').value.trim();

        const newActivity = {
          id: 'act_' + Date.now(),
          title: title,
          category: category,
          date: date,
          location: location,
          desc: desc,
          organizer: state.profile.name,
          attendeesCount: 1,
          joined: true,
          isUserCreated: true
        };

        state.activities.unshift(newActivity);
        saveState();

        document.getElementById('formCreateActivity').reset();
        closeModal('modalCreateActivity');
        navigate('activities');
        showToast('Campus Activity proposed successfully! 📅', 'success');
      }

      // ----------------------------------------------------------------------
      // 11. STUDENT PROFILE
      // ----------------------------------------------------------------------
      function renderProfile() {
        document.getElementById('profileCardName').textContent = state.profile.name;
        document.getElementById('profileCardAvatar').textContent = state.profile.avatar || 'ST';
        document.getElementById('profileCardMajor').textContent = state.profile.major;
        document.getElementById('profileCardBio').textContent = `"${state.profile.bio}"`;
        document.getElementById('profileJoinedCount').textContent = state.profile.joinedCommunityIds.length;

        // Render Interests
        const interestsContainer = document.getElementById('profileCardInterests');
        interestsContainer.innerHTML = state.profile.interests.map(int => `
          <span class="mini-tag" style="background:var(--indigo-50); color:var(--indigo-600); font-weight:600; font-size:0.8rem; padding:0.25rem 0.65rem;">
            ${escapeHtml(int)}
          </span>
        `).join('');

        // Render Joined Communities Badges
        const joinedContainer = document.getElementById('profileCardJoinedBadges');
        const joined = state.communities.filter(c => state.profile.joinedCommunityIds.includes(c.id));
        joinedContainer.innerHTML = joined.map(c => `
          <button class="mini-tag" style="background:var(--slate-100); color:var(--navy-900); font-size:0.8rem; cursor:pointer;" onclick="app.openCommunityDetail('${c.id}')">
            ${c.icon} ${escapeHtml(c.name)}
          </button>
        `).join('');

        // Render Peer Directory
        const peerContainer = document.getElementById('peerDirectoryList');
        peerContainer.innerHTML = SAMPLE_PEERS.map(p => `
          <div class="peer-item">
            <div class="peer-details-left">
              <div class="peer-avatar">${p.avatar}</div>
              <div>
                <div class="peer-name">${escapeHtml(p.name)}</div>
                <div class="peer-sub">${escapeHtml(p.role)}</div>
                <div class="peer-tags">
                  ${p.tags.map(t => `<span class="mini-tag" style="font-size:0.7rem; background:var(--slate-100); color:var(--slate-600);">#${escapeHtml(t)}</span>`).join('')}
                </div>
              </div>
            </div>
            <button class="btn btn-outline btn-sm" onclick="app.sendPeerGreeting('${p.name}')">
              <span>Wave 👋</span>
            </button>
          </div>
        `).join('');
      }

      function sendPeerGreeting(name) {
        showToast(`Waved hello to ${name}! Friendly greetings sent. 👋`, 'info');
      }

      function openEditProfileModal() {
        document.getElementById('editNameInput').value = state.profile.name;
        document.getElementById('editMajorInput').value = state.profile.major;
        document.getElementById('editBioInput').value = state.profile.bio;

        const pillsContainer = document.getElementById('modalInterestPills');
        pillsContainer.innerHTML = ALL_AVAILABLE_INTERESTS.map(int => {
          const isSelected = state.profile.interests.includes(int);
          return `
            <div class="interest-selectable-chip ${isSelected ? 'active' : ''}" onclick="this.classList.toggle('active')">
              ${escapeHtml(int)}
            </div>
          `;
        }).join('');

        document.getElementById('modalEditProfile').classList.add('open');
      }

      function handleProfileSave(event) {
        event.preventDefault();
        const name = document.getElementById('editNameInput').value.trim();
        const major = document.getElementById('editMajorInput').value.trim();
        const bio = document.getElementById('editBioInput').value.trim();

        const selectedPills = Array.from(document.querySelectorAll('#modalInterestPills .interest-selectable-chip.active'))
          .map(el => el.textContent.trim());

        state.profile.name = name;
        state.profile.major = major;
        state.profile.bio = bio;
        state.profile.interests = selectedPills.length > 0 ? selectedPills : ['Campus Connect'];
        state.profile.avatar = name.split(' ').map(n=>n[0]).join('').slice(0, 2).toUpperCase() || 'ST';

        saveState();
        closeModal('modalEditProfile');
        renderProfile();
        updateNavUser();
        showToast('Profile and interests updated! 🎉', 'success');
      }

      function updateNavUser() {
        const initialsEl = document.getElementById('navAvatarInitials');
        const nameEl = document.getElementById('navUserName');
        if (initialsEl) initialsEl.textContent = state.profile.avatar || 'ST';
        if (nameEl) nameEl.textContent = state.profile.name;
      }

      // ----------------------------------------------------------------------
      // 12. MODAL CONTROLS & KEYBOARD LISTENERS
      // ----------------------------------------------------------------------
      function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) modal.classList.remove('open');
      }

      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
          toggleMobileMenu(false);
        }
      });

      // ----------------------------------------------------------------------
      // 13. INITIALIZATION
      // ----------------------------------------------------------------------
      function init() {
        updateNavUser();
        
        // Handle hash navigation
        const initialHash = window.location.hash.replace('#', '');
        if (['landing', 'dashboard', 'communities', 'doubts', 'activities', 'profile'].includes(initialHash)) {
          navigate(initialHash);
        } else {
          navigate('landing');
        }
      }

      // Public API
      return {
        init,
        navigate,
        scrollToSection,
        toggleMobileMenu,
        filterCommunities,
        setCommunityCategory,
        resetCommunityFilters,
        toggleJoinCommunity,
        openCommunityDetail,
        toggleJoinActiveCommunity,
        postCommunityMessage,
        toggleLikeMessage,
        filterDoubts,
        setDoubtSubject,
        toggleAnswersSection,
        voteAnswerHelpful,
        submitAnswer,
        openAskDoubtModal,
        handleDoubtSubmit,
        filterActivities,
        setActivityCategory,
        toggleActivityRSVP,
        openCreateActivityModal,
        handleActivitySubmit,
        filterByInterestTag,
        openEditProfileModal,
        handleProfileSave,
        sendPeerGreeting,
        closeModal
      };
    })();
    window.app = app;

    // Initialize application on DOM ready
    document.addEventListener('DOMContentLoaded', app.init);
  </script>
</body>
</html>
